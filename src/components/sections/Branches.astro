---
import Section from "../Section.astro";
import FutureLink from "../FutureLink.astro";
import Icon from "../Icon.astro";
import { CITIES, PHONE } from "../../data/site";
---
<Section id="branches" class="branches" rec="U-R011">
  <div class="container">
    <div class="branches__head">
      <h2 class="h2">Філії ELIT по всій Україні</h2>
      <p class="muted branches__lead">Замовлення привозимо з найближчої філії. Київ — центральний офіс і склад.</p>
    </div>
    <ul class="cities" aria-label="Міста, де працюють філії ELIT">
      {CITIES.map((city) => (
        city === "Київ"
          ? <li class="cities__item cities__item--main"><span class="cities__name">Київ</span></li>
          : <li class="cities__item"><span class="cities__name">{city}</span></li>
      ))}
    </ul>
    <div class="branches__actions">
      <FutureLink note="Розділ у розробці" class="branches__more">Адреси та графік роботи філій</FutureLink>
      <a class="tel branches__tel" href={PHONE.href}><Icon name="phone" size={22} /><span>Центральний офіс:</span> <span class="branches__num">{PHONE.text}</span></a>
    </div>
  </div>
</Section>

<style>
  :global(.branches) { padding-block: var(--section-y); }
  .branches__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-12); }
  .branches__lead { max-width: 44ch; }
  .cities {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(16, minmax(0, 1fr));
    grid-auto-flow: column; column-gap: var(--gutter);
    border-top: 1px solid var(--color-line-strong);
    padding-top: var(--space-6);
  }
  .cities__item { display: flex; align-items: center; padding-block: var(--space-1); min-width: 0; }
  .cities__name { font-weight: 500; }
  .cities__item--main .cities__name { font-family: var(--font-display); font-weight: 700; color: var(--color-brand); }
  .branches__actions {
    margin-top: var(--space-12);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-8);
  }
  .branches__actions :global(.branches__more) { min-height: var(--tap); font-weight: 600; }
  .branches__tel { color: var(--color-brand); white-space: normal; flex-wrap: wrap; column-gap: var(--space-2); }
  .branches__num { white-space: nowrap; }

  @media (min-width: 48rem) {
    .branches__head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; gap: var(--gutter); }
    .cities { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(8, auto); }
  }
</style>
