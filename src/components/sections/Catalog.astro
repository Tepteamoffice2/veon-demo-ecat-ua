---
import Section from "../Section.astro";
import FutureLink from "../FutureLink.astro";
import { CATEGORIES, SOON } from "../../data/site";
---
<Section id="catalog" class="catalog" rec="U-R006">
  <div class="container">
    <div class="catalog__head">
      <h2 class="h2">Каталог: 11 розділів</h2>
      <p class="muted catalog__lead">Від запчастин для легкових і вантажних авто до всього для майстерні. Кожен розділ шукається за кодом, OE і VIN.</p>
    </div>
    <ul class="index" aria-label="Розділи каталогу">
      {CATEGORIES.map((name) => (
        <li class="index__item"><FutureLink note={SOON} class="index__link">{name}</FutureLink></li>
      ))}
    </ul>
    <ul class="plates">
      <li>
        <FutureLink note={SOON} class="plate">
          <span class="plate__name">Підбір оливи</span>
          <span class="plate__brands">MPM, VAT, ELF, Liqui Moly</span>
        </FutureLink>
      </li>
      <li>
        <FutureLink note={SOON} class="plate">
          <span class="plate__name">Підбір багажника</span>
          <span class="plate__brands">Thule</span>
        </FutureLink>
      </li>
    </ul>
  </div>
</Section>

<style>
  :global(.catalog) { padding-block: 0 var(--section-y); }
  :global(.catalog) > .container { border-top: 1px solid var(--color-line-strong); padding-top: var(--space-16); }
  .catalog__head { display: grid; gap: var(--space-4); margin-bottom: var(--space-8); }
  .catalog__lead { max-width: 46ch; }

  .index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); }
  .index__item { min-width: 0; }
  .index :global(.index__link) {
    display: inline; min-height: var(--tap);
    font-family: var(--font-display); font-weight: 600;
    font-size: 1.125rem; line-height: 1.3;
    font-variation-settings: "SHRP" var(--shrp);
    overflow-wrap: anywhere;
  }
  .index :global(.index__link:hover) { color: var(--color-brand); }

  .plates { display: grid; gap: var(--space-3); margin-top: var(--space-12); }
  .plates :global(.plate) {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6);
    width: 100%; padding: var(--space-6);
    background: var(--color-text); color: var(--color-bg);
    border-radius: var(--radius);
    text-decoration: none;
  }
  .plates :global(.plate .future-link__note) { background: var(--color-bg); color: var(--color-text); }
  .plate__name { font-family: var(--font-display); font-weight: 600; font-size: var(--fs-lg); line-height: var(--lh-lg); font-variation-settings: "SHRP" var(--shrp); }
  .plate__brands { color: var(--color-accent); font-weight: 500; text-decoration: underline dotted; text-decoration-thickness: 2px; text-underline-offset: 0.22em; text-decoration-color: var(--color-line-on-dark); }

  @media (min-width: 48rem) {
    .catalog__head { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; gap: var(--gutter); margin-bottom: var(--space-12); }
    .index { display: flex; flex-wrap: wrap; align-items: baseline; row-gap: var(--space-2); }
    .index__item { display: inline-flex; align-items: baseline; }
    .index :global(.index__link) { font-size: var(--fs-lg); line-height: 1.5; white-space: nowrap; }
    .index__item:not(:last-child)::after {
      content: "/"; margin-inline: var(--space-3);
      font-family: var(--font-display); font-size: var(--fs-lg); font-weight: 400; color: var(--color-brand);
    }
    .plates { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  }
</style>
